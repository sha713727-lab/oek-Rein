{
  "name": "zermae-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/http/start.ts",
    "start": "tsx src/server/http/start.ts",
    "build": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "migrate": "tsx src/server/database/migrate.ts",
    "seed": "tsx src/server/jobs/seed-admin.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "nodemailer": "9.0.3",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "tsx": "4.20.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/bcrypt": "6.0.0",
    "@types/node": "24.2.0",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.15.5",
    "eslint": "9.33.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  }
}
