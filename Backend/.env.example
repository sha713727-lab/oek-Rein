NODE_ENV=development
APP_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=5000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/zermae
DATABASE_MIGRATE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/zermae
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000

HMAC_SIGNING_SECRET=replace-with-64-char-hmac-signing-secret-value-not-a-real-secret
SESSION_SECRET=replace-with-64-char-session-secret-value-not-a-real-secret

SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=600
HMAC_TIMESTAMP_WINDOW_SECONDS=300

RATE_LIMIT_CAPACITY=400
RATE_LIMIT_REFILL_PER_SECOND=2

CORS_ORIGIN=http://localhost:3000
SUPPORT_EMAIL=support@example.com
EMAIL_FROM=Zermae <noreply@example.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# WhatsApp order alerts (use your shop number 03117003196 / +923117003196)
# Provider: ultramsg (easiest with a personal WhatsApp) or meta (official Cloud API)
WHATSAPP_PROVIDER=auto
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DIR=../Frontend/public/uploads
STORAGE_PROVIDER=local

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Zermae Admin
ADMIN_PASSCODE=1234
