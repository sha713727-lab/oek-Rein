NODE_ENV=production
# Public site URL (set to your domain, e.g. https://oakandrein.com)
APP_URL=https://YOUR_DOMAIN
API_HOST=0.0.0.0
API_PORT=5000
API_PREFIX=/api/v1

# Postgres on the VPS (replace host/user/password/db)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/oak_rein
DATABASE_MIGRATE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/oak_rein
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000

# Generate long random strings for production (do not reuse these placeholders)
HMAC_SIGNING_SECRET=replace-with-64-char-hmac-signing-secret-value-not-a-real-secret
SESSION_SECRET=replace-with-64-char-session-secret-value-not-a-real-secret

SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=600
HMAC_TIMESTAMP_WINDOW_SECONDS=300

RATE_LIMIT_CAPACITY=400
RATE_LIMIT_REFILL_PER_SECOND=2

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=https://YOUR_DOMAIN
SUPPORT_EMAIL=support@YOUR_DOMAIN
EMAIL_FROM=Oak & Rein <noreply@YOUR_DOMAIN>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# WhatsApp order alerts
WHATSAPP_PROVIDER=auto
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

UPLOAD_MAX_FILE_SIZE=41943040
UPLOAD_DIR=../Frontend/public/uploads
STORAGE_PROVIDER=local

# Admin account created by `npm run db:seed` / `npm run seed:admin`
# Set these on the VPS before seeding — change the password after first login
SEED_ADMIN_EMAIL=admin@YOUR_DOMAIN
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Oak & Rein Admin
# 4-digit OTP used on /admin/login (set your own)
ADMIN_PASSCODE=1234
