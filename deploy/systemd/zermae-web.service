[Unit]
Description=Zermae production web
After=network.target zermae-api.service
Wants=zermae-api.service

[Service]
Type=simple
User=zermae
Group=zermae
WorkingDirectory=/var/www/zermae/Frontend
EnvironmentFile=/var/www/zermae/Frontend/.env
Environment=HOME=/home/zermae
Environment=NODE_ENV=production
Environment=PORT=__WEB_PORT__
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=PATH=__NODE_BIN__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__NODE_BIN__/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port __WEB_PORT__
Restart=always
RestartSec=4
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/www/zermae
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
